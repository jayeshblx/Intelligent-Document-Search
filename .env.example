# =============================================================================
# Agentic RAG Platform — environment template.
# Copy to `.env` for local dev. In production, inject via your secrets manager
# (AWS Secrets Manager / SSM / K8s Secrets) — never bake secrets into images.
#
# Nested settings use the `__` delimiter (e.g. AWS__REGION maps to
# Settings.aws.region). See packages/core/src/rag_core/config/settings.py.
# =============================================================================

# ---- Application -----------------------------------------------------------
APP_ENV=local                 # local | dev | staging | prod
APP_NAME=agentic-rag
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                 # structured JSON logs (true in prod)
DEBUG=false

# ---- AWS -------------------------------------------------------------------
AWS__REGION=us-east-1
# For LocalStack dev only; leave blank in real AWS (uses IAM role / env creds).
AWS__ENDPOINT_URL=http://localhost:4566
AWS__ACCESS_KEY_ID=test
AWS__SECRET_ACCESS_KEY=test
AWS__MAX_RETRIES=8

# ---- S3 (source of compliance documents) ----------------------------------
S3__BUCKET=example-index-bucket
S3__PREFIX=foxtrot/
S3__MULTIPART_THRESHOLD_MB=64

# ---- SQS (ingestion pipeline) ----------------------------------------------
SQS__INGESTION_QUEUE_URL=http://localhost:4566/000000000000/rag-ingestion
SQS__INGESTION_DLQ_URL=http://localhost:4566/000000000000/rag-ingestion-dlq
SQS__VISIBILITY_TIMEOUT_S=300
SQS__MAX_MESSAGES=10
SQS__WAIT_TIME_S=20

# ---- Bedrock (embeddings + LLM) --------------------------------------------
BEDROCK__REGION=us-east-1
BEDROCK__TITAN_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK__LLM_MODEL=us.anthropic.claude-sonnet-4-6-20250929-v1:0
BEDROCK__RERANK_MODEL=amazon.rerank-v1:0
BEDROCK__MAX_RETRIES=6
BEDROCK__TIMEOUT_S=60

# ---- Qdrant (vector store) -------------------------------------------------
QDRANT__URL=http://localhost:6333
QDRANT__API_KEY=
QDRANT__COLLECTION=compliance_chunks
QDRANT__PREFER_GRPC=true
QDRANT__TIMEOUT_S=30

# ---- OpenSearch (BM25 / full-text) -----------------------------------------
OPENSEARCH__URL=http://localhost:9200
OPENSEARCH__INDEX=compliance_fulltext
OPENSEARCH__USER=admin
OPENSEARCH__PASSWORD=admin

# ---- Neo4j (knowledge graph) -----------------------------------------------
NEO4J__URI=bolt://localhost:7687
NEO4J__USER=neo4j
NEO4J__PASSWORD=password
NEO4J__DATABASE=neo4j

# ---- Temporal (durable ingestion workflows) --------------------------------
TEMPORAL__HOST=localhost:7233
TEMPORAL__NAMESPACE=default
TEMPORAL__TASK_QUEUE=rag-ingestion

# ---- Redis (caching / dedup ledger) ----------------------------------------
REDIS__URL=redis://localhost:6379/0

# ---- Observability ---------------------------------------------------------
OTEL__EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL__SERVICE_NAMESPACE=rag
OTEL__ENABLED=true
PROMETHEUS__PORT=9100

# ---- External MongoDB metadata (system of record for document facets) -------
# When set, the indexer joins each S3 object to its AttachmentMetaData document
# by filename (GeneratedFileName == S3 basename) and uses the business fields
# (BusinessObject/ObjectCode/Status/DocumentCategory/...) as authoritative,
# filterable facets — and skips the LLM metadata step for those docs.
# Leave SEARCH_MONGO_URI blank to disable. Put the real URI only in .env.
SEARCH_MONGO_URI=
SEARCH_MONGO_DATABASE=FOXTROT_DEV
SEARCH_MONGO_COLLECTION=AttachmentMetaData
# S3 basename == GeneratedFileName (verified); index by both for a robust join.
SEARCH_MONGO_JOIN_FIELD=GeneratedFileName,OriginalFileName
# SEARCH_MONGO_TLS_CA_FILE=./certs/ca-bundle.pem   # only if TLS is MITM-intercepted

# ---- PDF extraction engine -------------------------------------------------
# pymupdf converts PDFs to Markdown (reliable/fast, no stalls) — recommended.
# pypdf = plain fast text; pdfplumber = rich word geometry + tables.
PROCESSING_PDF_ENGINE=pymupdf

# ---- OCR (scanned/image-only PDFs) -----------------------------------------
# textract = AWS Textract (managed, best accuracy); tesseract = local binary
# (rasterised by PyMuPDF, no poppler needed); none = skip OCR.
PROCESSING_OCR_PROVIDER=tesseract
# Path to the tesseract binary (blank = auto-detect / rely on PATH).
# Windows (UB-Mannheim build):
PROCESSING_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Query audit log (every answered question -> MongoDB) -------------------
# Write-only log of question/answer/tokens/cost/sources. A separate database and
# credential from SEARCH_MONGO_* above. Leave blank to disable; put the real URI
# only in .env (gitignored).
SEARCH_QUERY_LOG_URI=
SEARCH_QUERY_LOG_DATABASE=BRAVO_AI_DEV
SEARCH_QUERY_LOG_COLLECTION=ExampleApp_AI_Document_Search_Log
# SEARCH_QUERY_LOG_TLS_CA_FILE=./certs/ca-bundle.pem   # only if TLS is MITM-intercepted
# SEARCH_QUERY_LOG_MAX_ANSWER_CHARS=20000
